
# ── Email notifications (optional; unset = notifications logged, not sent) ──
EMAIL_FROM="LoqATS <no-reply@yourdomain.com>"
APP_BASE_URL="http://localhost:8000"
# Configure ONE provider:
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# ── Resume storage (off-database) ──
STORAGE_BACKEND=local          # local | s3 | gcs
LOCAL_STORAGE_DIR=./_file_store
# S3_BUCKET=
# S3_ENDPOINT_URL=             # for S3-compatible stores (R2, MinIO)
# GCS_BUCKET=

# ── Gemini AI (AI Studio free tier) ──
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_RPM=10          # requests/min cap; free tier is ~10-15, raise on paid/Vertex
# Vertex AI fallback (used only if GEMINI_API_KEY is unset):
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
